# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/gamesforstrangers

# CORS origin — the URL of the web app (Next.js)
CORS_ORIGIN=http://localhost:3001

# Cloudflare Turnstile secret key (optional — enables server-side bot verification)
# TURNSTILE_SECRET_KEY=0x4AAAA...xxx

# Server port (defaults to 3002)
# SERVER_PORT=3002
