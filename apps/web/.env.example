# Server URL for client-side fetch calls
# In production, point this to your deployed server
NEXT_PUBLIC_SERVER_URL=http://localhost:3002

# Cloudflare Turnstile site key (optional — enables bot protection on forms)
# Get one at https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...xxx

# Google Analytics measurement ID (optional — defaults to production ID)
# NEXT_PUBLIC_GA_ID=G-DLFDC0PGDW
